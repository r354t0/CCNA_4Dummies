---
// Fila de la ruta de estudio: una lección o un laboratorio, con su estado de progreso.
import type { Version } from '../data/blueprints';

interface Props {
  href: string;
  titulo: string;
  tipo: 'Lección' | 'Lab';
  progreso: string;
  minutos: number;
  examen: Partial<Record<Version, number>>;
  extra?: string;
}
const { href, titulo, tipo, progreso, minutos, examen, extra } = Astro.props;
const clases = [
  'item',
  tipo === 'Lab' ? 'item-lab' : '',
  examen['v1.1'] === undefined ? 'fuera-v11' : '',
  examen['v2.0'] === undefined ? 'fuera-v20' : '',
].join(' ');
---
<li class={clases} data-progreso={progreso}>
  <span class="item-led" aria-hidden="true"></span>
  <span class="item-tipo">{tipo}</span>
  <a href={href}>{titulo}</a>
  <span class="item-meta">
    {extra && <>{extra}, </>}{minutos} min
    {examen['v1.1'] === undefined && <span class="solo-v11">, no entra en v1.1</span>}
    {examen['v2.0'] === undefined && <span class="solo-v20">, no entra en v2.0</span>}
  </span>
  <span class="visually-hidden item-estado-si">(completado)</span>
</li>

<style>
  .item {
    display: grid;
    grid-template-columns: 14px 3.2rem 1fr;
    grid-template-areas: 'led tipo titulo' '. . meta';
    column-gap: 0.6rem;
    align-items: baseline;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .item + .item { margin-top: 0; }
  @media (min-width: 720px) {
    .item { grid-template-columns: 14px 3.2rem 1fr auto; grid-template-areas: 'led tipo titulo meta'; }
  }
  .item-led {
    grid-area: led; width: 10px; height: 10px; border-radius: 50%;
    background: var(--led-off); align-self: center;
  }
  .item[data-hecho='si'] .item-led { background: var(--led-on); box-shadow: 0 0 5px var(--led-on); }
  .item-estado-si { display: none; }
  .item[data-hecho='si'] .item-estado-si { display: inline; }
  .item-tipo { grid-area: tipo; font-size: 0.85rem; color: var(--muted); }
  .item-lab .item-tipo { color: var(--ink); font-weight: 600; }
  .item a { grid-area: titulo; font-weight: 500; color: var(--ink); text-decoration-color: var(--line-strong); }
  .item a:hover { text-decoration-color: currentColor; }
  .item-meta { grid-area: meta; font-size: 0.88rem; color: var(--muted); }
</style>
