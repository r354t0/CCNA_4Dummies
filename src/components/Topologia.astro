---
// Dibuja una topología en SVG con íconos al estilo de los diagramas de red de Cisco.
// Uso en MDX:
// <Topologia ancho={640} alto={320}
//   nodos={[{ id: 'R1', tipo: 'router', x: 320, y: 60, detalle: 'G0/0/1 192.168.1.1' }, ...]}
//   enlaces={[{ a: 'R1', b: 'S1', ia: 'G0/0/1', ib: 'G0/1' }, ...]} />
//
// Varios enlaces entre los mismos dos equipos se dibujan en paralelo. Si además comparten
// `grupo` (por ejemplo 'Po1'), se dibuja el óvalo de EtherChannel con ese nombre.
//
// x, y son el centro del ícono. Los enlaces se recortan al borde de cada ícono y las
// interfaces se dibujan como etiquetas sobre el cable, junto al equipo al que pertenecen.

type Tipo = 'router' | 'switch' | 'pc' | 'servidor' | 'laptop' | 'nube';
type Lado = 'arriba' | 'abajo' | 'derecha' | 'izquierda';
// lado: dónde va el nombre del equipo. Por defecto: router arriba, switch a la derecha, hosts abajo.
interface Nodo { id: string; tipo: Tipo; x: number; y: number; etiqueta?: string; detalle?: string; lado?: Lado; }
interface Enlace { a: string; b: string; ia?: string; ib?: string; tipo?: 'cobre' | 'serial' | 'consola' | 'fibra'; grupo?: string; }
interface Props {
  nodos: Nodo[];
  enlaces: Enlace[];
  ancho?: number;
  alto?: number;
  titulo?: string;
}

const { nodos, enlaces, ancho = 640, alto = 320, titulo = 'Topología del laboratorio' } = Astro.props;
const uid = `topo-${Math.random().toString(36).slice(2, 8)}`;
const porId = new Map(nodos.map((n) => [n.id, n]));

// Medio ancho, medio alto y forma de cada ícono (deben coincidir con los dibujos de abajo).
const TAMANO: Record<Tipo, { w: number; h: number; forma: 'elipse' | 'rect' }> = {
  router: { w: 30, h: 18, forma: 'elipse' },
  switch: { w: 31, h: 14, forma: 'rect' },
  pc: { w: 22, h: 20, forma: 'rect' },
  servidor: { w: 13, h: 22, forma: 'rect' },
  laptop: { w: 23, h: 13, forma: 'rect' },
  nube: { w: 30, h: 18, forma: 'elipse' },
};
const HUECO = 3; // espacio entre el ícono y el inicio del cable

/** Distancia desde el centro del nodo hasta su borde en la dirección (ux, uy). */
function borde(n: Nodo, ux: number, uy: number) {
  const t = TAMANO[n.tipo];
  if (t.forma === 'elipse') return 1 / Math.hypot(ux / t.w, uy / t.h) + HUECO;
  const kx = ux === 0 ? Infinity : t.w / Math.abs(ux);
  const ky = uy === 0 ? Infinity : t.h / Math.abs(uy);
  return Math.min(kx, ky) + HUECO;
}

const ANCHO_CARACTER = 6.7; // fuente monoespaciada de 11 px
const ALTO_ETIQUETA = 16;

// Enlaces paralelos: se reparten a ambos lados del eje que une los dos equipos.
const SEPARACION = 14;
const clavePar = (e: Enlace) => [e.a, e.b].sort().join('|');
const totalPorPar = new Map<string, number>();
enlaces.forEach((e) => totalPorPar.set(clavePar(e), (totalPorPar.get(clavePar(e)) ?? 0) + 1));
const vistosPorPar = new Map<string, number>();

const trazos = enlaces.map((e) => {
  const a = porId.get(e.a);
  const b = porId.get(e.b);
  if (!a || !b) throw new Error(`Topologia: enlace con nodo inexistente ${e.a} - ${e.b}`);
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const largo = Math.hypot(dx, dy) || 1;
  const ux = dx / largo;
  const uy = dy / largo;
  const da = borde(a, ux, uy);
  const db = borde(b, -ux, -uy);

  // Desplazamiento perpendicular, siempre medido en el mismo sentido para un par de equipos.
  const clave = clavePar(e);
  const total = totalPorPar.get(clave)!;
  const indice = vistosPorPar.get(clave) ?? 0;
  vistosPorPar.set(clave, indice + 1);
  const signo = e.a < e.b ? 1 : -1;
  const desfase = (indice - (total - 1) / 2) * SEPARACION;
  const px = -uy * signo * desfase;
  const py = ux * signo * desfase;

  // La etiqueta se centra sobre el cable, pegada al borde del equipo.
  const etiqueta = (texto: string | undefined, desde: Nodo, d: number, sx: number, sy: number) => {
    if (!texto) return null;
    const w = texto.length * ANCHO_CARACTER + 10;
    const recorrido = (w * Math.abs(sx) + ALTO_ETIQUETA * Math.abs(sy)) / 2;
    const dist = d + 5 + recorrido;
    const ox = desde.x + px;
    const oy = desde.y + py;
    return { texto, w, sx, sy, ox, oy, dist, max: largo / 2, x: ox + sx * dist, y: oy + sy * dist };
  };

  return {
    e, a, b, ux, uy,
    x1: a.x + px + ux * da, y1: a.y + py + uy * da,
    x2: b.x + px - ux * db, y2: b.y + py - uy * db,
    la: etiqueta(e.ia, a, da, ux, uy),
    lb: etiqueta(e.ib, b, db, -ux, -uy),
  };
});

// Si dos etiquetas se tocan (típico cuando salen varios cables del mismo equipo),
// se desplaza a lo largo de su cable la que va por el cable más inclinado.
type Etiqueta = NonNullable<(typeof trazos)[number]['la']>;
const etiquetas = trazos.flatMap((t) => [t.la, t.lb]).filter((l): l is Etiqueta => l !== null);
const MARGEN = 5;
const chocan = (p: Etiqueta, q: Etiqueta) =>
  Math.abs(p.x - q.x) < (p.w + q.w) / 2 + MARGEN && Math.abs(p.y - q.y) < ALTO_ETIQUETA + MARGEN;
const inclinacion = (l: Etiqueta) => Math.min(Math.abs(l.sx), Math.abs(l.sy));
for (let vuelta = 0; vuelta < 200; vuelta++) {
  let movida = false;
  for (let i = 0; i < etiquetas.length; i++) {
    for (let j = i + 1; j < etiquetas.length; j++) {
      const [p, q] = [etiquetas[i], etiquetas[j]];
      if (!chocan(p, q)) continue;
      const mover = inclinacion(q) >= inclinacion(p) ? q : p;
      const otra = mover === q ? p : q;
      const elegida = mover.dist < mover.max ? mover : otra.dist < otra.max ? otra : null;
      if (!elegida) continue;
      elegida.dist += 2;
      elegida.x = elegida.ox + elegida.sx * elegida.dist;
      elegida.y = elegida.oy + elegida.sy * elegida.dist;
      movida = true;
    }
  }
  if (!movida) break;
}

// Óvalo de EtherChannel: abraza los enlaces del grupo en el punto medio entre los equipos.
const grupos = [...new Set(trazos.filter((t) => t.e.grupo).map((t) => `${clavePar(t.e)}|${t.e.grupo}`))].map((k) => {
  const miembros = trazos.filter((t) => t.e.grupo && `${clavePar(t.e)}|${t.e.grupo}` === k);
  const t0 = miembros[0];
  const mx = (t0.a.x + t0.b.x) / 2;
  const my = (t0.a.y + t0.b.y) / 2;
  const angulo = (Math.atan2(t0.uy, t0.ux) * 180) / Math.PI;
  const radio = ((miembros.length - 1) * SEPARACION) / 2 + 9;
  const nombre = t0.e.grupo!;
  const w = nombre.length * ANCHO_CARACTER + 10;
  // La etiqueta del port-channel va al costado del óvalo, fuera de los cables.
  const nx = -t0.uy;
  const ny = t0.ux;
  const d = radio + 6 + (w * Math.abs(nx) + ALTO_ETIQUETA * Math.abs(ny)) / 2;
  return { mx, my, angulo, radio, nombre, w, lx: mx + nx * d, ly: my + ny * d };
});

const LADO_POR_TIPO: Record<Tipo, Lado> = {
  router: 'arriba', switch: 'derecha', nube: 'derecha', pc: 'abajo', laptop: 'abajo', servidor: 'abajo',
};
function rotulo(n: Nodo) {
  const lado = n.lado ?? LADO_POR_TIPO[n.tipo];
  const { w, h } = TAMANO[n.tipo];
  const conDetalle = Boolean(n.detalle);
  switch (lado) {
    case 'arriba': return { x: 0, y: -h - 9 - (conDetalle ? 14 : 0), anchor: 'middle' };
    case 'derecha': return { x: w + 10, y: conDetalle ? -2 : 5, anchor: 'start' };
    case 'izquierda': return { x: -w - 10, y: conDetalle ? -2 : 5, anchor: 'end' };
    default: return { x: 0, y: h + 17, anchor: 'middle' };
  }
}

const descripcion = enlaces
  .map((e) => `${e.a}${e.ia ? ` ${e.ia}` : ''} conectado a ${e.b}${e.ib ? ` ${e.ib}` : ''}${e.tipo === 'consola' ? ' por cable de consola' : ''}`)
  .join('; ');
const hayConsola = enlaces.some((e) => e.tipo === 'consola');
const haySerial = enlaces.some((e) => e.tipo === 'serial');
const hayFibra = enlaces.some((e) => e.tipo === 'fibra');
const hayGrupo = grupos.length > 0;
---
<figure class="topologia">
  <svg viewBox={`0 0 ${ancho} ${alto}`} role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
    <title id={`${uid}-t`}>{titulo}</title>
    <desc id={`${uid}-d`}>{descripcion}</desc>

    {trazos.map((t) => (
      <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class={`enlace enlace-${t.e.tipo ?? 'cobre'}`} />
    ))}

    {grupos.map((g) => (
      <ellipse class="etherchannel" cx={g.mx} cy={g.my} rx="8" ry={g.radio}
        transform={`rotate(${g.angulo} ${g.mx} ${g.my})`} />
    ))}

    {nodos.map((n) => (
      <g class={`nodo nodo-${n.tipo}`} transform={`translate(${n.x} ${n.y})`}>
        {n.tipo === 'router' && (
          <>
            {/* Cilindro con cuatro flechas: dos entran y dos salen */}
            <path d="M-30 -6 V7 A30 11 0 0 0 30 7 V-6 Z" class="cara-frente" />
            <ellipse cx="0" cy="-6" rx="30" ry="11" class="cara-superior" />
            <g class="flechas">
              <path d="M-25 -6 H-11 M25 -6 H11 M0 -9 V-12 M0 -3 V0" />
              <path d="M-7 -6 L-12.5 -9.5 L-12.5 -2.5 Z M7 -6 L12.5 -9.5 L12.5 -2.5 Z M0 -16 L-3.5 -12 L3.5 -12 Z M0 4 L-3.5 0 L3.5 0 Z" class="punta" />
            </g>
          </>
        )}
        {n.tipo === 'switch' && (
          <>
            {/* Caja en perspectiva con flechas en sentidos opuestos en la cara superior */}
            <polygon points="-31,-2 -23,-14 31,-14 23,-2" class="cara-superior" />
            <rect x="-31" y="-2" width="54" height="16" class="cara-frente" />
            <polygon points="23,-2 31,-14 31,2 23,14" class="cara-lateral" />
            <g class="flechas">
              <path d="M-18 -10.5 H17 M18 -5.5 H-17" />
              <path d="M22 -10.5 L16.5 -13.2 L16.5 -7.8 Z M-22 -5.5 L-16.5 -8.2 L-16.5 -2.8 Z" class="punta" />
            </g>
          </>
        )}
        {n.tipo === 'pc' && (
          <>
            <rect x="-22" y="-22" width="44" height="31" rx="2.5" class="carcasa" />
            <rect x="-17.5" y="-17.5" width="35" height="22" rx="1.2" class="pantalla" />
            <path d="M-4 9 V14 H4 V9" class="carcasa" />
            <rect x="-14" y="14" width="28" height="5" rx="2" class="carcasa" />
          </>
        )}
        {n.tipo === 'servidor' && (
          <>
            <rect x="-13" y="-22" width="26" height="44" rx="2" class="carcasa" />
            <rect x="-9" y="-17" width="18" height="5" rx="1" class="bahia" />
            <rect x="-9" y="-9" width="18" height="5" rx="1" class="bahia" />
            <rect x="-9" y="-1" width="18" height="5" rx="1" class="bahia" />
            <circle cx="6" cy="15" r="2" class="led" />
          </>
        )}
        {n.tipo === 'laptop' && (
          <>
            <rect x="-16" y="-15" width="32" height="20" rx="2" class="carcasa" />
            <rect x="-12.5" y="-11.5" width="25" height="13" rx="1" class="pantalla" />
            <path d="M-20 5 H20 L23 11 H-23 Z" class="carcasa" />
          </>
        )}
        {n.tipo === 'nube' && (
          <path d="M-18 16 A11 11 0 0 1 -26 -2 A12 12 0 0 1 -12 -14 A15 15 0 0 1 14 -15 A12 12 0 0 1 28 0 A10 10 0 0 1 20 16 Z" class="carcasa" />
        )}
        {(() => {
          const r = rotulo(n);
          return (
            <>
              <text class="nombre" x={r.x} y={r.y} text-anchor={r.anchor}>{n.etiqueta ?? n.id}</text>
              {n.detalle && <text class="detalle" x={r.x} y={r.y + 14} text-anchor={r.anchor}>{n.detalle}</text>}
            </>
          );
        })()}
      </g>
    ))}

    {grupos.map((g) => (
      <g class="interfaz interfaz-grupo" transform={`translate(${g.lx} ${g.ly})`}>
        <rect x={-g.w / 2} y={-ALTO_ETIQUETA / 2} width={g.w} height={ALTO_ETIQUETA} rx="3" />
        <text text-anchor="middle" dy="0.35em">{g.nombre}</text>
      </g>
    ))}

    {etiquetas.map((l) => (
      <g class="interfaz" transform={`translate(${l.x} ${l.y})`}>
        <rect x={-l.w / 2} y={-ALTO_ETIQUETA / 2} width={l.w} height={ALTO_ETIQUETA} rx="3" />
        <text text-anchor="middle" dy="0.35em">{l.texto}</text>
      </g>
    ))}
  </svg>
  {(hayConsola || haySerial || hayFibra || hayGrupo) && (
    <figcaption>
      <span class="ley"><svg width="28" height="6" aria-hidden="true"><line x1="0" y1="3" x2="28" y2="3" class="enlace" /></svg> Cobre</span>
      {hayConsola && <span class="ley"><svg width="28" height="6" aria-hidden="true"><line x1="0" y1="3" x2="28" y2="3" class="enlace enlace-consola" /></svg> Cable de consola</span>}
      {haySerial && <span class="ley"><svg width="28" height="6" aria-hidden="true"><line x1="0" y1="3" x2="28" y2="3" class="enlace enlace-serial" /></svg> Serial</span>}
      {hayGrupo && <span class="ley"><svg width="28" height="14" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" class="enlace" /><line x1="0" y1="10" x2="28" y2="10" class="enlace" /><ellipse cx="14" cy="7" rx="4" ry="6.5" class="etherchannel" /></svg> EtherChannel</span>}
      {hayFibra && <span class="ley"><svg width="28" height="6" aria-hidden="true"><line x1="0" y1="3" x2="28" y2="3" class="enlace enlace-fibra" /></svg> Fibra</span>}
    </figcaption>
  )}
</figure>

<style>
  .topologia {
    --ic-superior: #4b8bd0;
    --ic-frente: #2462a6;
    --ic-lateral: #1a4a80;
    --ic-carcasa: #e3e8ee;
    --ic-borde: #6f8193;
    margin: 0 0 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    padding: 0.5rem;
    overflow-x: auto;
  }
  :global(html[data-tema='oscuro']) .topologia {
    --ic-carcasa: #c9d2db;
    --ic-borde: #8a9aaa;
  }
  svg { display: block; width: 100%; min-width: 480px; height: auto; }

  .enlace { stroke: var(--line-strong); stroke-width: 2.5; stroke-linecap: round; }
  .enlace-serial { stroke: var(--bad); stroke-dasharray: 8 5; }
  .enlace-consola { stroke: var(--n5); stroke-dasharray: 2 5; stroke-width: 2.5; }
  .enlace-fibra { stroke: var(--n1); }
  .etherchannel { fill: none; stroke: var(--ink); stroke-width: 1.6; }
  .interfaz-grupo rect { stroke: var(--ink); }
  .interfaz-grupo text { font-weight: 600; }

  .cara-superior { fill: var(--ic-superior); }
  .cara-frente { fill: var(--ic-frente); }
  .cara-lateral { fill: var(--ic-lateral); }
  .flechas path { stroke: #fff; stroke-width: 2; fill: none; stroke-linecap: round; }
  .flechas .punta { fill: #fff; stroke: none; }
  .carcasa { fill: var(--ic-carcasa); stroke: var(--ic-borde); stroke-width: 1.4; stroke-linejoin: round; }
  .pantalla { fill: var(--ic-frente); }
  .bahia { fill: var(--ic-borde); }
  .led { fill: var(--led-on); }

  .nombre {
    font-family: var(--font-head); font-weight: 700; font-size: 14px; fill: var(--ink);
    stroke: var(--surface); stroke-width: 4px; paint-order: stroke;
  }
  .detalle {
    font-family: var(--font-cli); font-size: 10.5px; fill: var(--muted);
    stroke: var(--surface); stroke-width: 4px; paint-order: stroke;
  }
  .interfaz rect { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1; }
  .interfaz text { font-family: var(--font-cli); font-size: 11px; fill: var(--ink); }

  figcaption {
    display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem;
    padding: 0.3rem 0.5rem 0.1rem; font-size: 0.85rem; color: var(--muted);
  }
  .ley { display: inline-flex; align-items: center; gap: 0.4rem; }
  .ley svg { min-width: 0; width: 28px; }
</style>
