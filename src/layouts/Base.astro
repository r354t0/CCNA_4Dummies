---
import '../styles/global.css';
import { url } from '../lib/url';
import { INICIO_V20 } from '../data/blueprints';

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion = 'Repasa CCNA 200-301 con teoría breve y laboratorios en Packet Tracer y GNS3.' } = Astro.props;

const ruta = Astro.url.pathname;
const nav = [
  { href: url(''), texto: 'Ruta de estudio', activo: ruta === url('') || ruta.startsWith(url('lecciones')) },
  { href: url('labs/'), texto: 'Laboratorios', activo: ruta.startsWith(url('labs')) },
  { href: url('practica/subnetting/'), texto: 'Subnetting', activo: ruta.startsWith(url('practica')) },
  { href: url('examen/'), texto: 'Temario', activo: ruta.startsWith(url('examen')) },
];
---
<!doctype html>
<html lang="es" data-examen="v2.0">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo === 'CCNA 4Dummies' ? titulo : `${titulo} | CCNA 4Dummies`}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;1,400&family=Barlow+Semi+Condensed:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <script is:inline define:vars={{ INICIO_V20 }}>
      // Versión del examen: la elegida por el alumno, o la vigente según la fecha.
      (function () {
        var v = null;
        try { v = localStorage.getItem('ccna-examen'); } catch (e) {}
        if (v !== 'v1.1' && v !== 'v2.0') {
          v = new Date() >= new Date(INICIO_V20 + 'T00:00:00') ? 'v2.0' : 'v1.1';
        }
        document.documentElement.dataset.examen = v;
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="wrap cabecera-fila">
        <a class="marca" href={url('')}>
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <rect x="2" y="9" width="28" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="2.4" />
            <rect x="9" y="13" width="14" height="8" rx="1" fill="currentColor" />
            <circle cx="6.5" cy="5" r="2.2" fill="var(--led-on)" />
          </svg>
          <span>CCNA <strong>4Dummies</strong></span>
        </a>
        <nav aria-label="Secciones">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={n.activo ? 'page' : undefined}>{n.texto}</a></li>
            ))}
          </ul>
        </nav>
        <div class="selector" role="group" aria-label="Versión del examen que preparas">
          <span class="selector-titulo">Examen</span>
          <button type="button" data-set-examen="v1.1">v1.1</button>
          <button type="button" data-set-examen="v2.0">v2.0</button>
        </div>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="wrap">
        <p>
          Proyecto abierto para estudiantes de CCNA 200-301. Tu progreso se guarda solo en este navegador.{' '}
          <a href="https://github.com/r354t0/CCNA_4Dummies">Código y laboratorios en GitHub</a>.
        </p>
        <p class="pie-legal">CCNA y Cisco son marcas de Cisco Systems, Inc. Este sitio no está afiliado a Cisco.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var KEY = 'ccna-progreso';
        function leer() { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } }
        function guardar(o) { try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {} }

        function pintar() {
          var p = leer();
          var v = document.documentElement.dataset.examen;
          document.querySelectorAll('[data-set-examen]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.setExamen === v));
          });
          document.querySelectorAll('[data-progreso]').forEach(function (el) {
            el.dataset.hecho = p[el.dataset.progreso] ? 'si' : 'no';
          });
          document.querySelectorAll('[data-progreso-boton]').forEach(function (b) {
            var h = !!p[b.dataset.progresoBoton];
            b.setAttribute('aria-pressed', String(h));
            b.querySelector('[data-texto]').textContent = h ? 'Completado' : 'Marcar como completado';
          });
          document.querySelectorAll('[data-led]').forEach(function (el) {
            var ids = el.dataset.led.split(' ').filter(Boolean);
            var n = ids.filter(function (i) { return p[i]; }).length;
            el.dataset.estado = ids.length && n === ids.length ? 'completo' : n > 0 ? 'en-curso' : 'pendiente';
            var t = el.querySelector('[data-led-texto]');
            if (t) t.textContent = n + ' de ' + ids.length + ' completados';
          });
        }

        document.addEventListener('click', function (e) {
          var t = e.target.closest('[data-set-examen], [data-progreso-boton]');
          if (!t) return;
          if (t.dataset.setExamen) {
            document.documentElement.dataset.examen = t.dataset.setExamen;
            try { localStorage.setItem('ccna-examen', t.dataset.setExamen); } catch (err) {}
          } else {
            var p = leer();
            var id = t.dataset.progresoBoton;
            if (p[id]) delete p[id]; else p[id] = true;
            guardar(p);
          }
          pintar();
        });

        pintar();
      })();
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute; left: 8px; top: -60px; z-index: 10;
    background: var(--surface); padding: 0.5rem 0.8rem; border-radius: var(--radius-s);
  }
  .saltar:focus { top: 8px; }

  .cabecera {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .cabecera-fila {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem;
    min-height: 64px; padding-top: 0.5rem; padding-bottom: 0.5rem;
  }
  .marca {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--ink); text-decoration: none;
    font-family: var(--font-head); font-size: 1.3rem; font-weight: 500;
  }
  .marca strong { font-weight: 700; }
  nav { flex: 1 1 auto; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; }
  nav li + li { margin-top: 0; }
  nav a {
    color: var(--muted); text-decoration: none; font-weight: 500;
    padding: 0.25rem 0; border-bottom: 2px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--ink); }

  .selector {
    display: inline-flex; align-items: center;
    border: 1px solid var(--line-strong); border-radius: 999px; padding: 3px;
    font-size: 0.9rem;
  }
  .selector-titulo { padding: 0 0.6rem 0 0.7rem; color: var(--muted); }
  .selector button {
    font: inherit; font-weight: 600; cursor: pointer;
    border: 0; border-radius: 999px; padding: 0.2rem 0.75rem;
    background: transparent; color: var(--muted);
  }
  .selector button[aria-pressed='true'] { background: var(--ink); color: var(--surface); }

  main { padding: 2.5rem 0 4rem; }

  .pie { border-top: 1px solid var(--line); padding: 1.5rem 0 2rem; color: var(--muted); font-size: 0.95rem; }
  .pie p { margin: 0 0 0.4rem; max-width: var(--measure); }
  .pie-legal { font-size: 0.85rem; }
</style>
