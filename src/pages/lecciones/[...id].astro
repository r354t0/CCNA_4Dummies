---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ExamenInfo from '../../components/ExamenInfo.astro';
import BotonProgreso from '../../components/BotonProgreso.astro';
import Quiz from '../../components/Quiz.tsx';
import { NIVELES } from '../../data/niveles';
import { url } from '../../lib/url';
import { idProgresoLeccion, urlLeccion, urlLab, type Leccion } from '../../lib/contenido';

export async function getStaticPaths() {
  const lecciones = (await getCollection('lecciones')).sort((a, b) => a.data.nivel - b.data.nivel || a.data.orden - b.data.orden);
  return lecciones.map((leccion, i) => ({
    params: { id: leccion.id },
    props: { leccion, anterior: lecciones[i - 1], siguiente: lecciones[i + 1] },
  }));
}

interface Props { leccion: Leccion; anterior?: Leccion; siguiente?: Leccion; }
const { leccion, anterior, siguiente } = Astro.props;
const { data } = leccion;
const { Content } = await render(leccion);
const nivel = NIVELES.find((n) => n.numero === data.nivel)!;
const labs = (await getCollection('labs')).filter((l) => data.labs.includes(l.id));
---
<Base titulo={data.titulo} descripcion={data.descripcion}>
  <article class="wrap pagina" style={`--c:${nivel.color}`}>
    <p class="miga"><a href={url(`#nivel-${nivel.numero}`)}>Nivel {nivel.numero}: {nivel.nombre}</a></p>
    <h1>{data.titulo}</h1>
    <p class="bajada">{data.descripcion}</p>
    <p class="meta">
      <span>Lección de {data.duracion} minutos.</span>
      <ExamenInfo examen={data.examen} />
    </p>
    {data.examen['v1.1'] === undefined && (
      <p class="aviso aviso-fuera-v11">Este tema no está en el temario v1.1. Puedes saltarlo o leerlo como base para la v2.0.</p>
    )}
    {data.examen['v2.0'] === undefined && (
      <p class="aviso aviso-fuera-v20">Este tema ya no figura en el temario v2.0. Sigue siendo útil como base, pero no es prioridad.</p>
    )}

    <div class="prose">
      <Content />
    </div>

    {labs.length > 0 && (
      <section class="prose" aria-labelledby="labs-t">
        <h2 id="labs-t">Practica en el laboratorio</h2>
        <ul class="labs">
          {labs.map((l) => (
            <li>
              <a href={urlLab(l)}>{l.data.titulo}</a>
              <span>{l.data.herramienta}, {l.data.duracion} minutos, dificultad {l.data.dificultad.toLowerCase()}.</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {data.quiz.length > 0 && (
      <section aria-labelledby="quiz-t">
        <h2 id="quiz-t" class="titulo-seccion">Comprueba lo que aprendiste</h2>
        <Quiz client:visible id={leccion.id} preguntas={data.quiz} />
      </section>
    )}

    <div class="cierre">
      <BotonProgreso id={idProgresoLeccion(leccion)} />
    </div>

    <nav class="secuencia" aria-label="Lecciones">
      {anterior ? <a href={urlLeccion(anterior)} rel="prev"><span>Anterior</span>{anterior.data.titulo}</a> : <span />}
      {siguiente && <a href={urlLeccion(siguiente)} rel="next" class="sig"><span>Siguiente</span>{siguiente.data.titulo}</a>}
    </nav>
  </article>
</Base>

<style>
  .pagina { border-left: 6px solid var(--c); padding-left: 1.2rem; }
  @media (min-width: 720px) { .pagina { padding-left: 2rem; } }
  .miga { margin-bottom: 0.4rem; }
  .miga a { color: var(--muted); }
  .bajada { font-size: 1.2rem; max-width: 60ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 0.2rem 1.2rem; color: var(--muted); font-size: 0.95rem; }
  .titulo-seccion { padding-top: 0.5rem; border-top: 1px solid var(--line); margin-top: 2.5rem; max-width: var(--measure); }
  .labs { list-style: none; padding: 0; }
  .labs li { display: flex; flex-direction: column; padding: 0.6rem 0.9rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m); }
  .labs li + li { margin-top: 0.5rem; }
  .labs a { font-weight: 600; }
  .labs span { color: var(--muted); font-size: 0.93rem; }
  .cierre { margin: 2rem 0; }
  .secuencia { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 1rem; max-width: var(--measure); }
  .secuencia a { display: flex; flex-direction: column; max-width: 30ch; font-weight: 500; }
  .secuencia a span { color: var(--muted); font-size: 0.85rem; font-weight: 400; }
  .secuencia .sig { text-align: right; margin-left: auto; }
</style>
