---
import Base from '../../layouts/Base.astro';
import { CURSOS } from '../../data/cursos';
import { EJERCICIOS, type TipoEjercicio } from '../../data/practica';
import { temas, urlModulo } from '../../lib/teoria';
import { anclaModulo } from '../../lib/navegacion';
import { url } from '../../lib/url';

// Un bloque por curso y, dentro, uno por módulo que tenga teoría publicada.
const cursos = await Promise.all(CURSOS.map(async (c) => {
  const conTeoria = new Set((await temas(c.id)).map((t) => t.data.modulo));
  const modulos = c.modulos
    .filter((m) => conTeoria.has(m.numero))
    .map((m) => ({ ...m, ejercicios: EJERCICIOS.filter((e) => e.curso === c.id && e.modulos[0] === m.numero) }))
    .filter((m) => m.ejercicios.length);
  return { ...c, modulos, conTeoria };
}));
const conModulos = cursos.filter((c) => c.modulos.length);
const extra = EJERCICIOS.filter((e) => !cursos.find((c) => c.id === e.curso)!.conTeoria.has(e.modulos[0]));

const TIPOS: Record<TipoEjercicio, string> = {
  Interactivo: 'Ordena, relaciona y clasifica con escenarios nuevos en cada ronda.',
  'Consola IOS': 'Una consola de switch en el navegador que valida cada comando.',
  Diagnóstico: 'Lee salidas de comandos y encuentra la falla escondida.',
  'Packet Tracer': 'Arma la red en Packet Tracer, pega la configuración y la app la corrige.',
};
---
<Base titulo="Práctica" descripcion="Ejercicios aleatorios para practicar el CCNA: consola IOS, diagnóstico, interactivos y Packet Tracer.">
  <div class="wrap" style="--c: var(--n2)">
    <header class="cab">
      <h1>Práctica</h1>
      <p class="bajada">
        Cada ejercicio genera un escenario distinto: otros nombres, otras direcciones, otras fallas. Repítelos hasta
        resolverlos sin dudar. Cada escenario tiene un código; compártelo y tu instructor podrá abrir exactamente el mismo
        caso.
      </p>
      <ul class="tipos">
        {(Object.keys(TIPOS) as TipoEjercicio[]).map((t) => (
          <li><strong>{t}</strong><span>{TIPOS[t]}</span></li>
        ))}
      </ul>
      <nav class="saltos" aria-label="Ir a un curso">
        {conModulos.map((c) => (
          <a href={`#${c.id}`} style={`--cc:${c.color}`}><strong>{c.sigla}</strong> {c.titulo}</a>
        ))}
      </nav>
    </header>

    {conModulos.map((c) => (
      <section class="curso" id={c.id} style={`--cc:${c.color}`} aria-labelledby={`t-${c.id}`}>
        <h2 id={`t-${c.id}`} class="curso-titulo"><span class="sigla">{c.sigla}</span> {c.titulo}</h2>
        {c.modulos.map((m) => (
          <section class="modulo" id={anclaModulo(c.id, m.numero)} aria-labelledby={`m-${c.id}-${m.numero}`}>
            <div class="modulo-cab">
              <h3 id={`m-${c.id}-${m.numero}`}>Módulo {m.numero}: {m.titulo}</h3>
              <a class="a-teoria" href={urlModulo(c.id, m.numero)}>
                <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><path d="M3 4.5c2.5-1 4.8-1 7 .5 2.2-1.5 4.5-1.5 7-.5v11c-2.5-1-4.8-1-7 .5-2.2-1.5-4.5-1.5-7-.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><path d="M10 5v11" stroke="currentColor" stroke-width="1.7" /></svg>
                Teoría del módulo {m.numero}
              </a>
            </div>
            <ul class="ejercicios">
              {m.ejercicios.map((e) => (
                <li data-progreso={`e:${e.id}`}>
                  <a href={url(`practica/${e.ruta}`)}>
                    <span class="fila">
                      <span class="tipo">{e.tipo}</span>
                      <span class="led" aria-hidden="true"></span>
                    </span>
                    <span class="titulo">{e.titulo}</span>
                    <span class="desc">{e.descripcion}</span>
                    <span class="min">{e.minutos} min por escenario</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
    ))}

    {extra.length > 0 && (
      <section class="curso" aria-labelledby="m-extra">
        <h2 id="m-extra" class="curso-titulo">Herramientas para más adelante</h2>
        <ul class="ejercicios">
          {extra.map((e) => (
            <li data-progreso={`e:${e.id}`}>
              <a href={url(`practica/${e.ruta}`)}>
                <span class="fila"><span class="tipo">{e.tipo}</span><span class="led" aria-hidden="true"></span></span>
                <span class="titulo">{e.titulo}</span>
                <span class="desc">{e.descripcion}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .cab { margin-bottom: 1rem; }
  .bajada { font-size: 1.15rem; max-width: 64ch; }
  .tipos { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 0.6rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .tipos li { margin: 0; display: grid; gap: 0.1rem; border-left: 3px solid var(--c); padding-left: 0.7rem; }
  .tipos span { color: var(--muted); font-size: 0.95rem; }
  .saltos { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .saltos a { padding: 0.45rem 0.9rem; border-radius: 999px; border: 1.5px solid var(--cc); color: var(--ink); text-decoration: none; background: var(--surface); }
  .saltos a strong { color: var(--cc); }
  .saltos a:hover { background: var(--cc); color: #fff; }
  .saltos a:hover strong { color: #fff; }
  .curso { margin-top: 3rem; scroll-margin-top: 1rem; }
  .curso-titulo { display: flex; align-items: center; gap: 0.6rem; border-bottom: 3px solid var(--cc, var(--line)); padding-bottom: 0.4rem; }
  .sigla { font-size: 0.85rem; background: var(--cc, var(--n1)); color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; }
  .modulo { margin-top: 1.75rem; scroll-margin-top: 1rem; border-radius: 12px; }
  .modulo:target { outline: 3px solid var(--cc); outline-offset: 10px; }
  .modulo-cab { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.4rem 1rem; margin-bottom: 0.8rem; }
  .modulo-cab h3 { margin: 0; font-size: 1.3rem; }
  .a-teoria { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: var(--n3); text-decoration: none; padding: 0.3rem 0.75rem; border: 1.5px solid var(--n3); border-radius: 999px; }
  .a-teoria:hover { background: var(--n3); color: #fff; }
  .ejercicios { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); }
  .ejercicios li { margin: 0; }
  .ejercicios a {
    display: grid; gap: 0.35rem; align-content: start; height: 100%; padding: 1rem 1.1rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; border-top: 4px solid var(--c);
    color: var(--ink); text-decoration: none;
  }
  .ejercicios a:hover { border-color: var(--c); }
  .fila { display: flex; justify-content: space-between; align-items: center; }
  .tipo { font-size: 0.82rem; font-weight: 600; color: var(--c); }
  .led { width: 10px; height: 10px; border-radius: 50%; background: var(--led-off); }
  [data-hecho='si'] .led { background: var(--led-on); box-shadow: 0 0 5px var(--led-on); }
  .titulo { font-family: var(--font-head); font-weight: 700; font-size: 1.2rem; line-height: 1.2; }
  .desc { color: var(--muted); font-size: 0.95rem; }
  .min { font-size: 0.85rem; color: var(--muted); }
</style>
