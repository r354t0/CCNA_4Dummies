---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ExamenInfo from '../../components/ExamenInfo.astro';
import BotonProgreso from '../../components/BotonProgreso.astro';
import { NIVELES } from '../../data/niveles';
import { url } from '../../lib/url';
import { idProgresoLab, urlLeccion, type Lab } from '../../lib/contenido';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((lab) => ({ params: { id: lab.id }, props: { lab } }));
}

interface Props { lab: Lab; }
const { lab } = Astro.props;
const { data } = lab;
const { Content } = await render(lab);
const nivel = NIVELES.find((n) => n.numero === data.nivel)!;
const lecciones = (await getCollection('lecciones')).filter((l) => l.data.labs.includes(lab.id));
const repo = 'https://github.com/r354t0/CCNA_4Dummies';
---
<Base titulo={data.titulo} descripcion={data.descripcion}>
  <article class="wrap pagina" style={`--c:${nivel.color}`}>
    <p class="miga"><a href={url('labs/')}>Laboratorios</a> / Nivel {nivel.numero}: {nivel.nombre}</p>
    <h1>{data.titulo}</h1>
    <p class="bajada">{data.descripcion}</p>

    <dl class="ficha">
      <div><dt>Herramienta</dt><dd>{data.herramienta}</dd></div>
      <div><dt>Tipo</dt><dd>{data.tipo}</dd></div>
      <div><dt>Dificultad</dt><dd>{data.dificultad}</dd></div>
      <div><dt>Duración</dt><dd>{data.duracion} minutos</dd></div>
      <div><dt>Equipos</dt><dd>{data.dispositivos.join(', ')}</dd></div>
      <div><dt>Examen</dt><dd><ExamenInfo examen={data.examen} /></dd></div>
    </dl>

    <div class="archivo">
      {data.archivo ? (
        <p>
          <a class="descarga" href={url(`labs/${data.archivo}`)} download>Descargar el archivo del laboratorio</a>
          Ábrelo con la versión de {data.herramienta} indicada en el enunciado.
        </p>
      ) : (
        <p>
          <strong>Archivo de práctica en preparación.</strong> Mientras tanto, arma la topología tú mismo siguiendo la
          sección «Topología» y la tabla de direccionamiento: construirla también es parte del aprendizaje.
          ¿Ya lo armaste? <a href={`${repo}/blob/main/docs/CREAR-LABS.md`}>Así puedes aportarlo al proyecto</a>.
        </p>
      )}
    </div>

    {lecciones.length > 0 && (
      <p class="teoria">
        Teoría relacionada: {lecciones.map((l, i) => <>{i > 0 && ', '}<a href={urlLeccion(l)}>{l.data.titulo}</a></>)}.
      </p>
    )}

    <div class="prose">
      <Content />
    </div>

    <div class="cierre">
      <BotonProgreso id={idProgresoLab(lab)} />
    </div>
  </article>
</Base>

<style>
  .pagina { border-left: 6px solid var(--c); padding-left: 1.2rem; }
  @media (min-width: 720px) { .pagina { padding-left: 2rem; } }
  .miga { margin-bottom: 0.4rem; color: var(--muted); }
  .miga a { color: var(--muted); }
  .bajada { font-size: 1.2rem; max-width: 60ch; }
  .ficha {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.8rem 1.5rem;
    margin: 1.5rem 0; padding: 1rem 1.1rem; max-width: 900px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m);
  }
  .ficha dt { font-size: 0.85rem; color: var(--muted); }
  .ficha dd { margin: 0; font-weight: 500; }
  .archivo { max-width: var(--measure); border-left: 4px solid var(--c); padding: 0.2rem 0 0.2rem 1rem; margin-bottom: 1.5rem; }
  .archivo p { margin: 0; }
  .descarga { font-weight: 600; margin-right: 0.4rem; }
  .teoria { color: var(--muted); max-width: var(--measure); }
  .cierre { margin: 2rem 0; }
</style>
