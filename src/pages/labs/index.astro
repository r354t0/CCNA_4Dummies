---
import Base from '../../layouts/Base.astro';
import ItemRuta from '../../components/ItemRuta.astro';
import { NIVELES } from '../../data/niveles';
import { porNivel, idProgresoLab, urlLab } from '../../lib/contenido';

const { grupos } = await porNivel();
const niveles = NIVELES.map((n) => ({ ...n, labs: grupos.get(n.numero)!.labs }));
const total = niveles.reduce((a, n) => a + n.labs.length, 0);
---
<Base titulo="Laboratorios" descripcion="Laboratorios de CCNA en Packet Tracer y GNS3, ordenados por nivel.">
  <div class="wrap">
    <h1>Laboratorios</h1>
    <p class="bajada">
      {total} laboratorios publicados. Cada uno trae topología, tabla de direccionamiento, tareas, comandos de
      verificación con la salida esperada y la solución completa. Los de troubleshooting esconden fallas que tienes
      que encontrar.
    </p>
    <aside class="herramientas">
      <p>
        <strong>Packet Tracer</strong> se usa en los niveles 1 a 4: es gratuito con una cuenta de Cisco Networking
        Academy y corre en equipos modestos.
        <strong>GNS3</strong> se usa cuando hace falta IOS real, como en automatización con Ansible. Necesitas tus
        propias imágenes de IOS (por ejemplo, de Cisco Modeling Labs): este proyecto no puede distribuirlas.
      </p>
    </aside>

    {niveles.map((n) => (
      <section class="nivel" style={`--c:${n.color}`} aria-labelledby={`l-${n.numero}`}>
        <h2 id={`l-${n.numero}`}>Nivel {n.numero}: {n.nombre}</h2>
        {n.labs.length > 0 ? (
          <ul class="lista">
            {n.labs.map((l) => (
              <ItemRuta tipo="Lab" href={urlLab(l)} titulo={l.data.titulo} progreso={idProgresoLab(l)}
                minutos={l.data.duracion} examen={l.data.examen}
                extra={`${l.data.herramienta}, ${l.data.tipo.toLowerCase()}`} />
            ))}
          </ul>
        ) : (
          <p class="vacio">Los laboratorios de este nivel están en preparación.</p>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .bajada { font-size: 1.15rem; max-width: 62ch; }
  .herramientas { max-width: var(--measure); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m); padding: 0.9rem 1.1rem; }
  .herramientas p { margin: 0; }
  .nivel { margin-top: 2.5rem; border-left: 6px solid var(--c); padding-left: 1.2rem; }
  .nivel h2 { margin-top: 0; }
  .lista { list-style: none; padding: 0; margin: 0; max-width: 900px; border-top: 1px solid var(--line); }
  .vacio { color: var(--muted); }
</style>
